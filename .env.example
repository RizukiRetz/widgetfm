# ── Last.FM ────────────────────────────────────────────────────────────────────
LAST_FM_USERNAME=           # Your Last.FM username
API_KEY=                    # LastFM API KEY(https://www.last.fm/api/accounts)

# ── stats.fm (optional) ────────────────────────────────────────────────────────
# Required for: Top Artists widget (ENABLE_TOP_ARTISTS = True)
#               LS slot type "hoursstreamed" or "minutesstreamed" in config.py
# Leave blank if you only use Last.FM (Listening Stats still works without it).
STATSFM_USERNAME=           # Your stats.fm username

# ── Discord ────────────────────────────────────────────────────────────────────
# Your Discord user ID (numeric, e.g. 123456789012345678)
USER_ID=                    # Activate Developer Mode in your discord setting to be able to see your user ID

# Listening Stats widget — Discord Application #1
APPLICATION_ID=             # Discord Application ID (https://discord.com/developers/applications -> Your application -> General Information -> Application ID)
BOT_TOKEN=                  # Discord Bot Token (https://discord.com/developers/applications > Your application > Bot > Reset Token)

# Top Artists widget — Discord Application #2
TOPARTISTS_APPLICATION_ID=  # Discord Application ID (https://discord.com/developers/applications -> Your application -> General Information -> Application ID)
TOPARTISTS_BOT_TOKEN=       # Discord Bot Token (https://discord.com/developers/applications > Your application > Bot > Reset Token)

# ── imgfixer (optional) ────────────────────────────────────────────────────────
# Only required when IMGFIXER_ENABLED = True in config.py.
# Create a webhook in a private Discord channel you own:
#   Channel Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_IMAGE_WEBHOOK_URL=  # https://discord.com/api/webhooks/...

# ── Spotify (optional — album art fallback) ────────────────────────────────────
# When Last.FM has no album art for a track (placeholder image), the bot will
# search Spotify and use its album cover instead.
# Create an app at: https://developer.spotify.com/dashboard
# Then copy the Client ID and Client Secret from the app settings.
# Leave blank to skip the Spotify fallback (Discord will show its default asset).
SPOTIFY_CLIENT_ID=              # Spotify App Client ID
SPOTIFY_CLIENT_SECRET=          # Spotify App Client Secret
SPOTIFY_REFRESH_TOKEN=          # Run: python spotify_auth.py  (leave blank to use search-only fallback)
